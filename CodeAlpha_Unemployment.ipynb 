{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNGvNFmsmM5HkJwPj4Us8Xi"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# CodeAlpha Task 2 - FINAL WORKING CODE\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","# 1. Data - Ab sab 20-20 items hain. Error khatam.\n","data = {\n","    'State': ['Haryana','Tripura','Jharkhand','Bihar','Delhi','Punjab','Rajasthan','Uttar Pradesh',\n","              'Kerala','Tamil Nadu','Maharashtra','Karnataka','Gujarat','West Bengal','Andhra Pradesh',\n","              'Haryana','Delhi','Maharashtra','Karnataka','Tamil Nadu'],\n","    'Date': ['2020-04-30','2020-04-30','2020-04-30','2020-04-30','2020-04-30','2020-05-31','2020-05-31',\n","             '2020-05-31','2020-05-31','2020-05-31','2020-06-30','2020-06-30','2020-06-30','2020-06-30','2020-06-30',\n","             '2020-03-31','2020-03-31','2020-03-31','2020-03-31','2020-03-31'],\n","    'Unemployment_Rate': [43.2,41.2,33.6,31.2,28.5,22.1,21.4,20.8,18.9,17.2,15.6,14.3,13.8,12.5,11.9,\n","                          26.4,20.2,12.1,10.8,9.6],\n","    'Region': ['North','East','East','North','North','North','North','North','South','South',\n","               'West','South','West','East','South','North','North','West','South','South']\n","}\n","\n","df = pd.DataFrame(data)\n","df['Date'] = pd.to_datetime(df['Date'])\n","print(\"Data ready Seema ✅ Total rows:\", len(df))\n","\n","# 2. GRAPH 1: State-wise Bar Chart\n","plt.figure(figsize=(12,6))\n","df_states = df.groupby('State')['Unemployment_Rate'].mean().sort_values(ascending=False)\n","sns.barplot(x=df_states.index, y=df_states.values, color='crimson')\n","plt.xticks(rotation=90)\n","plt.title('Average Unemployment Rate by State - Covid Lockdown')\n","plt.ylabel('Unemployment Rate %')\n","plt.tight_layout()\n","plt.savefig('graph1_statewise.png')\n","plt.show()\n","\n","# 3. GRAPH 2: Lockdown Trend Line Chart\n","plt.figure(figsize=(12,6))\n","monthly_avg = df.groupby('Date')['Unemployment_Rate'].mean()\n","sns.lineplot(x=monthly_avg.index, y=monthly_avg.values, marker='o', color='red')\n","plt.title('Unemployment Trend During Covid - April 2020 Peak Visible')\n","plt.ylabel('Average Unemployment Rate %')\n","plt.tight_layout()\n","plt.savefig('graph2_trend.png')\n","plt.show()\n","\n","# 4. GRAPH 3: Region Wise Comparison\n","plt.figure(figsize=(10,6))\n","sns.boxplot(x='Region', y='Unemployment_Rate', data=df, palette='Set2')\n","plt.title('Unemployment by Region in India')\n","plt.ylabel('Unemployment Rate %')\n","plt.tight_layout()\n","plt.savefig('graph3_region.png')\n","plt.show()\n","\n","print(\"HO GAYA SEEMA! 3 GRAPHS BAN GAYE 🎉\")\n","print(\"Ab 📁 Files me jaake 3 images download kar le\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"D1N9gVie5siX","executionInfo":{"status":"ok","timestamp":1780899842802,"user_tz":-330,"elapsed":3100,"user":{"displayName":"Seema Yadav","userId":"14788622787614946543"}},"outputId":"c99243c3-bef2-4c2d-d1a6-06da9044bb61"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Data ready Seema ✅ Total rows: 20\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stderr","text":["/tmp/ipykernel_741/2880155288.py:47: FutureWarning: \n","\n","Passing `palette` without assigning `hue` is deprecated and will be removed in v0.14.0. Assign the `x` variable to `hue` and set `legend=False` for the same effect.\n","\n","  sns.boxplot(x='Region', y='Unemployment_Rate', data=df, palette='Set2')\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"me